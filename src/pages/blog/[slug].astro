---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);

// Parse raw markdown body to calculate read time matrix based on 200wpm
const wordCount = entry.body ? entry.body.split(/\s+/).length : 0;
const readTime = Math.max(1, Math.ceil(wordCount / 200));
---
<Layout title={entry.data.seoTitle || `${entry.data.title} | The Log`} description={entry.data.seoDescription || entry.data.description} image={entry.data.image}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": entry.data.title,
      "image": entry.data.image ? `https://www.railshop.co${entry.data.image}` : "https://www.railshop.co/og-image.jpg",
      "author": {
        "@type": "Person",
        "name": entry.data.author || "Drew O."
      },
      "publisher": {
        "@type": "Organization",
        "name": "Railshop",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.railshop.co/favicon.svg"
        }
      },
      "datePublished": entry.data.date
    })} />
  </Fragment>
  <Navbar />
  <main class="w-full flex flex-col pt-32 pb-0 min-h-screen relative bg-brand-dark overflow-hidden">
      <!-- Structural Grid Background -->
      <div class="absolute inset-x-0 top-0 h-screen z-0 opacity-20 pointer-events-none bg-[radial-gradient(ellipse_at_top_right,#111_0%,transparent_70%)]"></div>

      <!-- Hero Header -->
      <div class="relative z-10 max-w-3xl mx-auto px-6 lg:px-8 w-full pb-12 pt-8 lg:pt-16">
          
          <!-- Breadcrumb Navigation -->
          <a href="/blog" class="inline-flex items-center gap-2 mb-12 font-mono text-xs tracking-widest text-brand-light/60 hover:text-brand-primary transition-colors group">
              <span class="text-brand-primary group-hover:-translate-x-1 transition-transform">&larr;</span> 
              RETURN TO DIRECTORY
          </a>

          <div class="flex items-center gap-4 mb-8 font-mono text-xs tracking-widest uppercase text-brand-light/60">
              <span class="text-brand-primary font-bold">/// {entry.data.category ? entry.data.category.replace("-", " ") : "INTELLIGENCE"}</span>
              <span class="text-white/20">|</span>
              <span class="text-white bg-white/5 py-1 px-3 border border-white/10">{readTime} MIN READ</span>
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white uppercase tracking-tight mb-8 leading-[1.1]">
              {entry.data.title}
          </h1>
          
          <div class="flex flex-wrap items-center gap-4 font-mono text-xs text-brand-light/40 uppercase tracking-widest pb-12">
              <span>{entry.data.date.toString().substring(0, 15)}</span>
              <span class="text-brand-primary hidden sm:inline-block">///</span>
              <span class="text-brand-light/80 border-b border-white/20 pb-0.5">AUTHOR: {entry.data.author || 'SYSTEM'}</span>
          </div>

          <!-- The Approved Structural Divider -->
          <div class="w-full h-px bg-white/5 mb-16"></div>

          <!-- Technical Dossier (Markdown Content) -->
          <article class="prose prose-invert max-w-none
              prose-headings:font-black prose-headings:text-white prose-headings:uppercase prose-headings:tracking-tight
              prose-h2:text-3xl prose-h2:md:text-4xl prose-h2:border-b prose-h2:border-white/5 prose-h2:pb-6 prose-h2:mt-20 prose-h2:mb-8
              prose-h3:text-brand-primary prose-h3:text-2xl prose-h3:mt-12 prose-h3:mb-6
              prose-p:text-brand-light/70 prose-p:leading-[1.8] prose-p:text-[18px] prose-p:mb-8
              prose-a:text-brand-primary prose-a:no-underline hover:prose-a:underline
              prose-code:font-mono prose-code:text-brand-primary prose-code:bg-brand-primary/10 prose-code:px-2 prose-code:py-1
              prose-strong:text-white prose-strong:font-bold prose-strong:bg-white/5 prose-strong:px-1
              pb-20">
              <Content />
          </article>
      </div>

      <!-- Author Identity Block -->
      <div class="relative z-10 w-full bg-[#030303] border-y border-white/5 py-12 md:py-16 mt-8">
          <div class="max-w-3xl mx-auto px-6 lg:px-8 w-full relative">
              <p class="font-mono text-brand-primary/40 tracking-[0.2em] text-xs mb-6 uppercase">/// ABOUT THE AUTHOR</p>
              
              <div class="flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-8 bg-[#050505] border border-white/10 p-6 md:p-8">
                  <!-- Avatar Placeholder -->
                  <div class="w-16 h-16 md:w-20 md:h-20 rounded-full border border-white/20 bg-brand-dark shrink-0 flex items-center justify-center overflow-hidden relative group">
                      <div class="absolute inset-0 bg-brand-primary/20 mix-blend-overlay opacity-0 group-hover:opacity-100 transition-opacity"></div>
                      <span class="font-mono font-black text-white/20 text-2xl tracking-widest">{entry.data.author?.substring(0,1) || "X"}</span>
                  </div>
                  
                  <div class="w-full flex-grow">
                      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 w-full mb-3">
                          <div>
                              <h4 class="text-xl md:text-2xl font-black text-white uppercase tracking-tight">{entry.data.author || 'Systems Engineer'}</h4>
                              <p class="font-mono text-brand-primary text-xs tracking-widest uppercase">Lead Strategist & Founder</p>
                          </div>
                          
                          <a href="https://linkedin.com" target="_blank" class="inline-flex items-center gap-2 font-mono text-xs tracking-widest text-brand-light/60 hover:text-white transition-colors group">
                              CONNECT ON LINKEDIN 
                              <span class="text-brand-primary group-hover:translate-x-1 transition-transform">&rarr;</span>
                          </a>
                      </div>
                      <div class="w-full h-px bg-white/5 mb-5"></div>
                      <p class="text-brand-light/50 text-sm md:text-base leading-relaxed">
                          Building high-performance digital infrastructure for local service companies. We focus strictly on deploying conversion architecture that scales dispatch flow and drives raw revenue.
                      </p>
                  </div>
              </div>
          </div>
      </div>

      <!-- Master Global Endcap Call to Action -->
      <section class="relative w-full z-20 text-center bg-brand-primary border-t border-brand-mid mt-auto">
          <div class="max-w-5xl mx-auto px-6 lg:px-8 w-full py-16 md:py-24">
              <p class="font-mono text-brand-dark/60 tracking-[0.2em] text-sm mb-6 uppercase font-bold">/// NEXT STEPS</p>
              <h2 class="text-4xl md:text-6xl font-black text-brand-dark mb-10 uppercase tracking-tight">Start your project.</h2>
              <a href="/contact" class="inline-flex justify-center items-center gap-3 bg-brand-dark hover:bg-white text-white hover:text-brand-dark px-8 md:px-10 py-5 font-bold font-mono tracking-widest text-sm shadow-[0_20px_50px_rgba(0,0,0,0.4)] transition-all duration-300 uppercase relative group z-30 w-full md:w-auto">
                  [ BOOK A CALL ]
              </a>
          </div>
      </section>

  </main>
  <Footer />
</Layout>
