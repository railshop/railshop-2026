---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Process from '../components/Process.astro';
---

<Layout title="About Railshop | Agency Operations & Team" description="Meet the strategic team behind Railshop. We don't sell digital business cards; we architect scalable local growth pipelines.">
  <Navbar />
  
  <main class="w-full flex flex-col min-h-screen relative bg-brand-dark overflow-hidden">
      <!-- Structural Grid Background -->
      <div class="absolute inset-x-0 top-0 h-screen z-0 opacity-20 pointer-events-none bg-[radial-gradient(ellipse_at_top_right,#111_0%,transparent_70%)]"></div>

      <!-- RS Working Muted Background -->
      <div class="absolute inset-x-0 top-0 h-[600px] lg:h-[700px] z-0 pointer-events-none overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/20 via-brand-dark/80 to-brand-dark z-20"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-transparent to-brand-dark z-10"></div>
          <img src="/images/hero/about-hero.webp" alt="Railshop Working" class="w-full h-full object-cover object-[center_30%] opacity-30 grayscale mix-blend-luminosity duration-1000 animate-fade-in" />
      </div>

      <!-- Hero Section -->
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full pt-32 pb-16 lg:pt-48 lg:pb-24 flex flex-col lg:flex-row items-center justify-between gap-12 border-b border-white/5">
          
          <!-- Left Column: The "Command" H1 -->
          <div class="w-full lg:w-8/12 animate-fade-in-up">
              <p class="font-mono text-brand-primary tracking-[0.2em] text-sm mb-4 uppercase">/// WHO WE ARE</p>
              <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white uppercase tracking-tight mb-8">
                  About <br class="hidden lg:block"/> Railshop.
              </h1>
              <p class="text-brand-light/60 text-lg md:text-xl max-w-xl font-light">
                  We are a highly technical digital growth firm building precision conversion systems for local home service sectors.
              </p>
          </div>

          <!-- Right Column: The Functional "Jump Stack" Navigation (Hidden on Mobile) -->
          <div class="hidden lg:flex w-full lg:w-4/12 flex-col justify-end lg:items-end gap-4 font-mono text-xs md:text-sm tracking-widest uppercase mt-8 lg:mt-0">
              <p class="text-brand-primary/40 mb-2 border-b border-brand-primary/20 pb-4 w-full lg:text-right">[ DIRECTORY ]</p>
              
              <a href="#story" class="text-white hover:text-brand-primary transition-colors flex items-center justify-start lg:justify-end gap-3 group">
                  <span class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-brand-primary">→</span> 
                  Origin Story
              </a>
              <a href="#approach" class="text-white hover:text-brand-primary transition-colors flex items-center justify-start lg:justify-end gap-3 group">
                  <span class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-brand-primary">→</span> 
                  Tactical Approach
              </a>
              <a href="#team" class="text-white hover:text-brand-primary transition-colors flex items-center justify-start lg:justify-end gap-3 group">
                  <span class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-brand-primary">→</span> 
                  The Team
              </a>
          </div>
      </div>

      <!-- Headquarters & Origin -->
      <section id="story" class="relative z-10 w-full bg-[#050505] border-b border-brand-mid overflow-hidden">
         <div class="max-w-7xl mx-auto px-6 lg:px-8 py-24 md:py-32">
             <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
                 <div>
                     <p class="font-mono text-brand-primary tracking-[0.2em] text-sm mb-4 uppercase">/// OUR MISSION</p>
                     <h2 class="text-3xl md:text-5xl font-black text-white uppercase tracking-tight mb-8 leading-tight">We Build <br/> <span class="text-brand-primary">Growth Engines.</span></h2>
                     <div class="prose prose-invert prose-p:text-brand-light/70 prose-p:leading-relaxed prose-p:text-lg">
                         <p>Our mandate is simple: Target established multi-location service businesses, local trades, consumer service sectors, and non-profits, and give them an unfair structural advantage to dominate their competitors.</p>
                         <p>Most local businesses are operating on outdated, slow, digital brochures. We saw a massive gap in the market for a highly-technical agency that doesn't just design pretty pages, but engineers ruthless lead-generation machines designed to drive revenue.</p>
                     </div>
                 </div>
                 <div class="relative aspect-[4/3] lg:aspect-square group w-full border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.8)] p-2 bg-[#111]">
                     <div class="absolute inset-0 bg-brand-primary/10 mix-blend-overlay group-hover:bg-transparent transition-all duration-500 z-10 pointer-events-none opacity-0 group-hover:opacity-100"></div>
                     <img src="/images/about/office_hq.jpg" alt="Railshop Headquarters Command Center" class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-700" />
                     
                     <!-- UI Elements -->
                     <div class="absolute top-6 left-6 w-8 h-8 border-t-2 border-l-2 border-white/30 z-20 pointer-events-none"></div>
                     <div class="absolute bottom-6 right-6 w-8 h-8 border-b-2 border-r-2 border-white/30 z-20 pointer-events-none"></div>

                 </div>
             </div>
         </div>
      </section>

      <!-- Tactical Methodology (Abstracted Component) -->
      <Process />

      <!-- Command Team (Moved Below Approach) -->
      <section id="team" class="relative z-10 w-full pt-24 pb-32 border-b border-brand-mid">
         <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full">
             <div class="mb-12 md:mb-20 flex flex-col items-center text-center w-full max-w-5xl mx-auto">
                 <div class="flex flex-col items-center">
                     <p class="font-mono text-brand-primary tracking-[0.2em] text-sm mb-4 uppercase">/// LEADERSHIP</p>
                     <h2 class="text-3xl md:text-5xl font-black tracking-tight mb-4 text-white uppercase">The Team.</h2>
                     <p class="text-brand-light/60 text-lg max-w-xl mx-auto">
                         The team building your digital strategy.
                     </p>
                 </div>
             </div>

             <!-- Dossier: Horizontal ID Cards -->
             <div class="flex flex-col gap-8 max-w-5xl mx-auto w-full">
                 <!-- Founder 1 (Drew) -->
                 <div class="group relative flex flex-col md:flex-row items-center md:items-stretch bg-[#020202] border border-white/10 hover:border-brand-primary/50 transition-all duration-500 overflow-hidden text-center md:text-left shadow-2xl shadow-black/50">
                     <!-- Image Cell -->
                     <div class="w-full md:w-72 h-72 md:h-auto shrink-0 bg-[#050505] relative border-b md:border-b-0 md:border-r border-white/10 p-2 overflow-hidden mx-auto md:mx-0">
                         <div class="absolute inset-0 bg-brand-primary/10 mix-blend-overlay z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                         <img src="/images/about/user_headshot.jpg" alt="Drew - Founder Profile" class="w-full h-full object-cover grayscale-[30%] group-hover:grayscale-0 transition-all duration-700" />
                         <!-- UI Constraints -->
                         <div class="absolute top-4 left-4 w-4 h-4 border-t-2 border-l-2 border-white/30 z-20 pointer-events-none group-hover:border-brand-primary transition-colors"></div>
                         <div class="absolute bottom-4 right-4 w-4 h-4 border-b-2 border-r-2 border-white/30 z-20 pointer-events-none group-hover:border-brand-primary transition-colors"></div>
                     </div>
                     <!-- Data Cell -->
                     <div class="p-8 md:p-12 flex flex-col justify-center flex-grow bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:1rem_1rem]">
                         <h3 class="text-3xl lg:text-4xl font-black text-white uppercase tracking-tight mb-2">Drew</h3>
                         <div class="font-mono text-brand-primary text-[10px] tracking-widest uppercase mb-4 border-b border-white/5 pb-3">CO-FOUNDER, HEAD OF DIGITAL STRATEGY</div>
                         <p class="text-brand-light/60 font-light text-base lg:text-lg leading-relaxed mb-8 max-w-2xl">Directing agency operations, client communication, and overall business strategy to ensure every deployment meets strict ROI parameters.</p>
                         <a href="https://linkedin.com/" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-brand-light hover:text-brand-primary uppercase tracking-widest flex items-center justify-center md:justify-start gap-3 transition-colors w-max mx-auto md:mx-0 group/link border border-white/20 px-6 py-3 hover:border-brand-primary hover:bg-brand-primary/10">
                             <span class="w-1.5 h-1.5 bg-brand-primary group-hover/link:bg-white transition-colors"></span>
                             CONNECT ON LINKEDIN
                         </a>
                     </div>
                 </div>

                 <!-- Founder 2 (Sean) -->
                 <div class="group relative flex flex-col md:flex-row items-center md:items-stretch bg-[#020202] border border-white/10 hover:border-brand-primary/50 transition-all duration-500 overflow-hidden text-center md:text-left shadow-2xl shadow-black/50">
                     <!-- Image Cell -->
                     <div class="w-full md:w-72 h-72 md:h-auto shrink-0 bg-[#050505] relative border-b md:border-b-0 md:border-r border-white/10 p-2 overflow-hidden mx-auto md:mx-0">
                         <div class="absolute inset-0 bg-brand-primary/10 mix-blend-overlay z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                         <img src="/images/about/sean_headshot.jpg" alt="Sean - Founder Profile" class="w-full h-full object-cover grayscale-[30%] group-hover:grayscale-0 transition-all duration-700" />
                         <!-- UI Constraints -->
                         <div class="absolute top-4 left-4 w-4 h-4 border-t-2 border-l-2 border-white/30 z-20 pointer-events-none group-hover:border-brand-primary transition-colors"></div>
                         <div class="absolute bottom-4 right-4 w-4 h-4 border-b-2 border-r-2 border-white/30 z-20 pointer-events-none group-hover:border-brand-primary transition-colors"></div>
                     </div>
                     <!-- Data Cell -->
                     <div class="p-8 md:p-12 flex flex-col justify-center flex-grow bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:1rem_1rem]">
                         <h3 class="text-3xl lg:text-4xl font-black text-white uppercase tracking-tight mb-2">Sean</h3>
                         <div class="font-mono text-brand-primary text-[10px] tracking-widest uppercase mb-4 border-b border-white/5 pb-3">CO-FOUNDER, HEAD OF PRODUCT AND OPERATIONS</div>
                         <p class="text-brand-light/60 font-light text-base lg:text-lg leading-relaxed mb-8 max-w-2xl">Engineering the dense, high-performance local web chassis and optimizing algorithms for maximum lead capture.</p>
                         <a href="https://linkedin.com/" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-brand-light hover:text-brand-primary uppercase tracking-widest flex items-center justify-center md:justify-start gap-3 transition-colors w-max mx-auto md:mx-0 group/link border border-white/20 px-6 py-3 hover:border-brand-primary hover:bg-brand-primary/10">
                             <span class="w-1.5 h-1.5 bg-brand-primary group-hover/link:bg-white transition-colors"></span>
                             CONNECT ON LINKEDIN
                         </a>
                     </div>
                 </div>
             </div>
         </div>
      </section>

      <!-- Inverted CTA -->
      <section class="relative w-full z-20 text-center bg-brand-primary border-t border-brand-mid mt-0">
          <div class="max-w-5xl mx-auto px-6 lg:px-8 w-full py-16 md:py-24">
              <p class="font-mono text-brand-dark/60 tracking-[0.2em] text-sm mb-6 uppercase font-bold">/// NEXT STEPS</p>
              <h2 class="text-4xl md:text-6xl font-black text-brand-dark mb-10 uppercase tracking-tight">Start your project.</h2>
              <a href="/contact" class="inline-flex justify-center items-center gap-3 bg-brand-dark hover:bg-white text-white hover:text-brand-dark px-8 md:px-10 py-5 font-bold font-mono tracking-widest text-sm shadow-[0_20px_50px_rgba(0,0,0,0.4)] transition-all duration-300 uppercase relative group z-30 w-full md:w-auto">
                  [ BOOK A CALL ]
              </a>
          </div>
      </section>
  </main>
  
  <Footer />
</Layout>
