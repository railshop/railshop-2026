---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="HVAC Case Study | Legacy Prototype">
	<Navbar />
    
    <main class="w-full flex flex-col pt-32 pb-0 min-h-screen relative bg-brand-dark">
        <!-- Structural Grid Background -->
        <div class="fixed inset-0 z-0 opacity-10 pointer-events-none">
            <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_80%_80%_at_50%_40%,#000_20%,transparent_100%)]"></div>
        </div>

        <!-- The Original Split-Screen Hero -->
        <section class="relative w-full overflow-hidden pt-12 pb-20 border-b border-white/10 z-10 text-left">
            <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full flex flex-col lg:flex-row items-center gap-16 relative">
                <div class="flex-1 w-full z-10 max-w-2xl">
                    <div class="inline-flex items-center gap-3 px-4 py-1.5 border border-brand-primary/40 bg-brand-primary/5 text-brand-primary text-xs font-mono uppercase tracking-[0.2em] mb-6 shadow-[0_0_10px_rgba(56,182,255,0.1)]">
                        <span class="w-1.5 h-1.5 rounded-none bg-brand-primary animate-pulse"></span> SYSTEM: CASE_STUDY_04
                    </div>
                    <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white tracking-tight mb-8 uppercase leading-[1.05]">
                        Apex Air HVAC
                    </h1>
                    <p class="text-lg md:text-xl text-brand-light/70 mb-10 leading-relaxed font-light">
                        We deployed a customized digital architecture designed specifically to scale high-ticket HVAC installations and dominate local service rankings.
                    </p>
                    <a href="/contact" class="inline-flex justify-center items-center gap-3 bg-brand-primary hover:bg-white text-brand-dark px-8 py-4 font-bold font-mono tracking-widest text-sm shadow-[inset_0_0_0_2px_#38b6ff] hover:shadow-[0_0_20px_rgba(255,255,255,0.5)] transition-all duration-300 uppercase relative group w-full sm:w-auto">
                        [ VIEW FULL LOG ]
                    </a>
                </div>
                
                <div class="flex-1 w-full relative group">
                    <div class="relative overflow-hidden border border-white/10 bg-[#020202] aspect-[4/3] w-full">
                        <div class="w-full h-full bg-brand-mid/50 flex flex-col items-center justify-center font-mono text-brand-primary border border-brand-primary/30">
                           <span class="opacity-50">[ ASSET PLACEHOLDER ]</span>
                        </div>
                        <!-- Crosshairs -->
                        <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-brand-primary z-20"></div>
                        <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-brand-primary z-20"></div>
                        <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-brand-primary z-20"></div>
                        <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-brand-primary z-20"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Metric Grid -->
        <section class="relative z-10 bg-[#020202] border-b border-brand-mid w-full py-16">
          <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full">
              <p class="font-mono text-brand-primary/60 tracking-[0.2em] text-xs mb-8 uppercase flex items-center gap-2">/// END-CYCLE TELEMETRY</p>
              
              <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.8)] relative group">
                  <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-brand-primary z-20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                  <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-brand-primary z-20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                  
                  <div class="bg-brand-mid/30 p-10 border-r border-b md:border-b-0 border-white/10 hover:bg-brand-mid transition-colors group/card relative">
                     <span class="block text-brand-light/40 text-[10px] font-mono tracking-widest uppercase mb-4 group-hover/card:text-brand-primary transition-colors">>> ORGANIC TRAFFIC</span>
                     <span class="font-black text-4xl md:text-5xl lg:text-6xl text-white block truncate">+400%</span>
                  </div>
                  <div class="bg-brand-mid/30 p-10 border-r border-b md:border-b-0 border-white/10 hover:bg-brand-mid transition-colors group/card">
                     <span class="block text-brand-light/40 text-[10px] font-mono tracking-widest uppercase mb-4 group-hover/card:text-brand-primary transition-colors">>> ACQUISITION COST</span>
                     <span class="font-black text-4xl md:text-5xl lg:text-6xl text-white block truncate">-$40</span>
                  </div>
                  <div class="bg-brand-mid/30 p-10 hover:bg-brand-mid transition-colors group/card">
                     <span class="block text-brand-light/40 text-[10px] font-mono tracking-widest uppercase mb-4 group-hover/card:text-brand-primary transition-colors">>> EXCLUSIVE LEADS</span>
                     <span class="font-black text-4xl md:text-5xl lg:text-6xl text-white block truncate">145/mo</span>
                  </div>
              </div>
          </div>
        </section>
    </main>

	<Footer />
</Layout>
