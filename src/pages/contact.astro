---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Railshop | Start Your Project" description="Book a one-on-one B2B scaling strategy session or submit an asynchronous project brief directly to our operations team.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "name": "Contact Railshop",
      "url": "https://www.railshop.co/contact",
      "description": "Book a one-on-one B2B scaling strategy session or submit an asynchronous project brief.",
      "mainEntity": {
        "@type": "ProfessionalService",
        "name": "Railshop",
        "email": "drew@railshop.co",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "33 East Pittsburgh St.",
          "addressLocality": "Greensburg",
          "addressRegion": "PA",
          "postalCode": "15601",
          "addressCountry": "US"
        }
      }
    })} />
  </Fragment>
  <Navbar />
  
  <main class="w-full flex flex-col min-h-screen relative bg-brand-dark overflow-hidden">
      <!-- Structural Grid Background -->
      <div class="absolute inset-x-0 top-0 h-screen z-0 opacity-20 pointer-events-none bg-[radial-gradient(ellipse_at_top_right,#111_0%,transparent_70%)]"></div>

      <!-- Office HQ Muted Background -->
      <div class="absolute inset-x-0 top-0 h-[600px] lg:h-[700px] z-0 pointer-events-none overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/20 via-brand-dark/80 to-brand-dark z-10"></div>
          <img src="/images/hero/contact-hero.webp" alt="Railshop Office HQ" class="w-full h-full object-cover opacity-30 grayscale mix-blend-luminosity duration-1000 animate-fade-in" />
      </div>

      <!-- Hero Section -->
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full pt-32 pb-16 lg:pt-48 lg:pb-24 flex flex-col lg:flex-row items-center justify-between gap-12 border-b border-white/5">
          
          <!-- Left Column -->
          <div class="w-full lg:w-8/12 animate-fade-in-up">
              <p class="font-mono text-brand-primary tracking-[0.2em] text-sm mb-4 uppercase">/// GET IN TOUCH</p>
              <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white uppercase tracking-tight mb-8">
                  Let's <br class="hidden lg:block"/> Build.
              </h1>
              <p class="text-brand-light/60 text-lg md:text-xl max-w-xl font-light leading-relaxed">
                  Access our operations team directly via a live strategy session, or submit your data below for asynchronous review.
              </p>
          </div>

          <!-- Right Column (Jump Stack) -->
          <div class="hidden lg:flex w-full lg:w-4/12 flex-col justify-end lg:items-end gap-4 font-mono text-xs md:text-sm tracking-widest uppercase mt-8 lg:mt-0">
              <p class="text-brand-primary/40 mb-2 border-b border-brand-primary/20 pb-4 w-full lg:text-right">[ CONTACT OPTIONS ]</p>
              
              <a href="#call" class="text-white hover:text-brand-primary transition-colors flex items-center justify-start lg:justify-end gap-3 group">
                  <span class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-brand-primary">→</span> 
                  Book Strategy Call
              </a>
              <a href="#brief" class="text-white hover:text-brand-primary transition-colors flex items-center justify-start lg:justify-end gap-3 group">
                  <span class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-brand-primary">→</span> 
                  Submit Project Details
              </a>
              <a href="/services" class="text-brand-primary hover:text-white transition-colors flex items-center justify-start lg:justify-end gap-3 group mt-6 pt-4 border-t border-white/5 w-full">
                  <span class="w-1.5 h-1.5 bg-brand-primary group-hover:bg-white transition-colors"></span> 
                  BACK TO SERVICES
              </a>
          </div>
      </div>

      <!-- The Split Pipeline Container -->
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full py-24 pb-32">
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">
              
              <!-- Left Pipeline: High-Value Booking Card -->
              <div id="call" class="bg-[#030303] border border-white/5 p-8 md:p-12 lg:p-14 lg:sticky lg:top-32 shadow-[0_30px_60px_rgba(0,0,0,0.4)] relative group overflow-hidden">
                  <!-- Decorative Cyber Corner -->
                  <div class="absolute top-0 right-0 w-16 h-16 border-t-2 border-r-2 border-brand-primary/30 group-hover:border-brand-primary transition-colors duration-500 rounded-tr-xl opacity-50"></div>
                  
                  <div class="border-b border-white/10 pb-8 mb-8 relative z-10">
                      <p class="font-mono text-brand-primary/60 tracking-[0.2em] text-xs mb-4 uppercase flex items-center gap-3">
                          <span class="w-2 h-2 rounded-full bg-brand-primary animate-pulse"></span>
                          DIRECT ACCESS
                      </p>
                      <h2 class="text-3xl lg:text-4xl font-black text-white uppercase tracking-tight mb-4">
                          One-On-One <br/> Strategy Session.
                      </h2>
                      <p class="text-brand-light/50 text-base leading-relaxed">
                          A raw, 30-minute teardown of your current digital pipelines. No sales pressure, just actionable intelligence focused entirely on scaling your digital marketing.
                      </p>
                  </div>
                  
                  <ul class="space-y-4 font-mono text-sm tracking-wide text-brand-light/70 uppercase mb-12 relative z-10">
                      <li class="flex items-start gap-4">
                          <span class="text-brand-primary mt-0.5">✓</span> 
                          <span>Current Digital Intake</span>
                      </li>
                      <li class="flex items-start gap-4">
                          <span class="text-brand-primary mt-0.5">✓</span> 
                          <span>Immediate Optimization Tactics</span>
                      </li>
                      <li class="flex items-start gap-4">
                          <span class="text-brand-primary mt-0.5">✓</span> 
                          <span>Post-Call Execution Roadmap</span>
                      </li>
                  </ul>

                  <a href="https://launch.railshop.co/meetings/andrew-opalinski" target="_blank" rel="noopener noreferrer" class="w-full inline-flex justify-center items-center gap-3 bg-brand-primary hover:bg-white text-brand-dark font-black tracking-widest uppercase transition-all shadow-[0_0_20px_rgba(56,182,255,0.2)] hover:shadow-[0_0_30px_rgba(255,255,255,0.4)] py-5 relative z-20 group/btn border border-brand-primary hover:border-white">
                      [ SCHEDULE CALL NOW ]
                      <span class="group-hover/btn:translate-x-1 transition-transform">&rarr;</span>
                  </a>
              </div>

              <!-- Right Pipeline: Asynchronous Project Brief -->
              <div id="brief" class="w-full flex flex-col pt-4 lg:pt-0">
                  <div class="mb-10">
                      <h2 class="text-3xl font-black text-white uppercase tracking-tight mb-3">Tell Us What's Broken.</h2>
                      <p class="text-brand-light/50 text-sm md:text-base leading-relaxed max-w-lg">Not ready for a call? Let us know where your business is currently struggling and what gaps need to be filled. Our team will review your project details and send over next steps.</p>
                  </div>

                  <form class="flex flex-col gap-8 w-full">
                      <!-- Standard English Labels + Sleek inputs -->
                      <div class="space-y-2 group">
                          <label for="name" class="block text-xs font-mono tracking-widest text-brand-light/50 group-focus-within:text-brand-primary transition-colors uppercase">
                              FULL NAME *
                          </label>
                          <input 
                              type="text" id="name" name="name" placeholder="John Doe" required
                              class="w-full bg-[#020202] border-b border-white/10 focus:border-brand-primary hover:border-white/30 outline-none px-4 py-4 text-white placeholder-brand-light/20 transition-all font-mono text-sm shadow-[inset_0_2px_10px_rgba(0,0,0,0.5)] leading-loose"
                          />
                      </div>

                      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                          <div class="space-y-2 group">
                              <label for="email" class="block text-xs font-mono tracking-widest text-brand-light/50 group-focus-within:text-brand-primary transition-colors uppercase">
                                  WORK EMAIL *
                              </label>
                              <input 
                                  type="email" id="email" name="email" placeholder="john@company.com" required
                                  class="w-full bg-[#020202] border-b border-white/10 focus:border-brand-primary hover:border-white/30 outline-none px-4 py-4 text-white placeholder-brand-light/20 transition-all font-mono text-sm shadow-[inset_0_2px_10px_rgba(0,0,0,0.5)] leading-loose"
                              />
                          </div>
                          <div class="space-y-2 group">
                              <label for="phone" class="block text-xs font-mono tracking-widest text-brand-light/50 group-focus-within:text-brand-primary transition-colors uppercase">
                                  PHONE NUMBER
                              </label>
                              <input 
                                  type="tel" id="phone" name="phone" placeholder="(555) 555-5555"
                                  class="w-full bg-[#020202] border-b border-white/10 focus:border-brand-primary hover:border-white/30 outline-none px-4 py-4 text-white placeholder-brand-light/20 transition-all font-mono text-sm shadow-[inset_0_2px_10px_rgba(0,0,0,0.5)] leading-loose"
                              />
                          </div>
                      </div>

                      <div class="space-y-2 group">
                          <label for="url" class="block text-xs font-mono tracking-widest text-brand-light/50 group-focus-within:text-brand-primary transition-colors uppercase">
                              CURRENT WEBSITE URL
                          </label>
                          <input 
                              type="url" id="url" name="url" placeholder="https://yourcompany.com"
                              class="w-full bg-[#020202] border-b border-white/10 focus:border-brand-primary hover:border-white/30 outline-none px-4 py-4 text-white placeholder-brand-light/20 transition-all font-mono text-sm shadow-[inset_0_2px_10px_rgba(0,0,0,0.5)] leading-loose"
                          />
                      </div>

                      <div class="space-y-2 group">
                          <label for="budget" class="block text-xs font-mono tracking-widest text-brand-light/50 group-focus-within:text-brand-primary transition-colors uppercase">
                              MONTHLY MARKETING BUDGET *
                          </label>
                          <div class="relative w-full">
                              <select 
                                  id="budget" name="budget" required
                                  class="w-full bg-[#020202] border-b border-white/10 focus:border-brand-primary hover:border-white/30 outline-none px-4 py-4 text-white appearance-none cursor-pointer transition-all font-mono text-sm shadow-[inset_0_2px_10px_rgba(0,0,0,0.5)] leading-loose"
                              >
                                  <option value="" disabled selected class="text-white/20">SELECT RANGE...</option>
                                  <option value="2.5k-10k">$2,500 - $10,000</option>
                                  <option value="10k-25k">$10,000 - $25,000</option>
                                  <option value="25k-50k">$25,000 - $50,000</option>
                                  <option value="50k-100k">$50,000 - $100,000</option>
                                  <option value="100k+">$100,000+</option>
                              </select>
                              <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/30">
                                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                              </div>
                          </div>
                      </div>

                      <div class="space-y-2 group">
                          <label for="details" class="block text-xs font-mono tracking-widest text-brand-light/50 group-focus-within:text-brand-primary transition-colors uppercase">
                              PROJECT DETAILS & GOALS *
                          </label>
                          <textarea 
                              id="details" name="details" rows="5" required
                              placeholder="Tell us about your current bottlenecks, target metrics, and what you want to achieve."
                              class="w-full bg-[#020202] border-b border-white/10 focus:border-brand-primary hover:border-white/30 outline-none px-4 py-4 text-white placeholder-brand-light/20 transition-all resize-none font-mono text-sm shadow-[inset_0_2px_10px_rgba(0,0,0,0.5)] leading-loose"
                          ></textarea>
                      </div>

                      <button 
                          type="submit" 
                          class="w-full md:w-max mt-4 bg-transparent border border-brand-primary hover:bg-brand-primary text-brand-primary hover:text-brand-dark font-mono font-bold tracking-widest uppercase transition-colors px-10 py-4 flex justify-center items-center gap-3 group/submit"
                      >
                          <span>[ SUBMIT PROJECT DETAILS ]</span>
                          <span class="group-hover/submit:translate-x-1 transition-transform">&rarr;</span>
                      </button>
                  </form>
              </div>

          </div>
      </div>

  </main>
  
  <Footer />
</Layout>
