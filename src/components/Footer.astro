---
---
<footer class="bg-[#020202] text-white pt-20 pb-12 border-t border-brand-primary/20 relative z-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full">
    
    <!-- Top Modular Spread -->
    <div class="flex flex-col lg:flex-row justify-between items-start gap-16 lg:gap-24 mb-20 w-full">
        
        {/* Left Pillar: Brand Identity */}
        <div class="w-full lg:w-1/3 flex flex-col gap-8">
            <a href="/" class="text-3xl font-black tracking-widest text-white flex items-center group uppercase">
              RAILSHOP<span class="text-brand-primary -ml-[2px]">.</span>
            </a>
            
            <p class="text-sm text-brand-light/60 leading-relaxed max-w-xs">Engineered for multi-location service domination.</p>
            
            <!-- Physical Location Array -->
            <div class="text-sm text-brand-light/60 leading-relaxed">
                <p>33 East Pittsburgh St.</p>
                <p>Greensburg, PA 15601</p>
            </div>
            
            <!-- Social Hooks -->
            <div class="flex items-center gap-6 mt-2">
                <a href="#" class="text-white hover:text-brand-primary transition-colors" aria-label="Instagram">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
