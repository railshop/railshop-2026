            </div>
        </div>

        {/* Right Pillar: Navigational Matrix */}
        <div class="w-full lg:w-2/3 flex flex-col sm:flex-row justify-start lg:justify-end gap-16 lg:gap-32">
            
            {/* Nav Array: Directory */}
            <div class="min-w-[140px]">
                <h4 class="font-bold text-white tracking-widest uppercase text-xs mb-6 font-mono">/// Directory</h4>
                <ul class="space-y-4 text-sm text-brand-light/70 tracking-wide">
                    <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
                    <li><a href="/services" class="hover:text-white transition-colors">Services</a></li>
                    <li><a href="/work" class="hover:text-white transition-colors">Our Work</a></li>
                    <li><a href="/blog" class="hover:text-white transition-colors">Blog</a></li>
                    <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
                </ul>
            </div>

            {/* Nav Array: Services */}
            <div class="min-w-[140px]">
                <h4 class="font-bold text-white tracking-widest uppercase text-xs mb-6 font-mono">/// Services</h4>
                <ul class="space-y-4 text-sm text-brand-light/70 tracking-wide">
                    <li><a href="/services/web-design" class="hover:text-white transition-colors">Web Design</a></li>
                    <li><a href="/services/seo" class="hover:text-white transition-colors">SEO</a></li>
                    <li><a href="/services/paid-ads" class="hover:text-white transition-colors">Paid Ads</a></li>
                    <li><a href="/services/content-creation" class="hover:text-white transition-colors">Content Creation</a></li>
                    <li><a href="/services/digital-strategy-consulting" class="hover:text-white transition-colors">Digital Strategy</a></li>
                    <li><a href="/services/ai-integration" class="hover:text-white transition-colors">AI Integration</a></li>
                </ul>
            </div>
            
        </div>
    </div>

    <!-- Base Ribbon Structure -->
    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 mt-8 md:mt-0">
        <p class="font-mono text-xs text-brand-light/40 tracking-widest text-center md:text-left">© {new Date().getFullYear()} RAILSHOP. ALL RIGHTS RESERVED.</p>
        <div class="flex gap-6 font-mono text-xs text-brand-light/40 tracking-widest">
            <a href="/privacy" class="hover:text-brand-primary transition-colors">PRIVACY POLICY</a>
        </div>
    </div>
  </div>
</footer>
