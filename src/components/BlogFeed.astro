---
import { getCollection } from 'astro:content';
import CategoryNav from './CategoryNav.astro';

interface Props {
  limit?: number;
  showHeader?: boolean;
  showImages?: boolean;
  showNav?: boolean;
  page?: any; // Accepting standard Astro Collection Page Object
}

const { limit = 3, showHeader = true, showImages = false, showNav = false, page } = Astro.props;

// Fetch and sort posts by date descending if no paginated payload is explicitly passed
let displayPosts;
if (page) {
    displayPosts = page.data;
} else {
    const rawPosts = await getCollection('blog');
    const sortedPosts = rawPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    displayPosts = sortedPosts.slice(0, limit);
}
---
<section class="py-24 bg-[#030303] overflow-hidden relative z-10 w-full">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 w-full">
        {showHeader && (
            <div class="mb-12 md:mb-20 flex flex-col md:flex-row md:items-end justify-between gap-6 md:gap-8 w-full">
                <div class="w-full md:w-auto">
                    <p class="font-mono text-brand-primary tracking-[0.2em] text-sm mb-4 uppercase">/// THE BLOG</p>
                    <h2 class="text-3xl md:text-5xl font-black tracking-tight uppercase text-white">Recent Articles.</h2>
                </div>
                <a href="/blog" class="font-mono text-brand-light hover:text-brand-primary text-sm tracking-widest uppercase flex items-center justify-center gap-2 transition-colors border border-white/20 px-6 py-4 hover:bg-brand-primary/10 hover:border-brand-primary w-full md:w-auto text-center mt-2 md:mt-0">
                    [ VIEW ALL ARTICLES ]
                </a>
            </div>
        )}

        {/* Category Ribbon */}
        {showNav && <CategoryNav />}
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {displayPosts.map((post) => (
                <a href={`/blog/${post.id}`} class="block bg-[#020202] border border-white/10 hover:border-brand-primary/50 hover:bg-brand-mid/30 transition-all group/card relative overflow-hidden flex flex-col shadow-2xl">
                    
                    {/* Dynamic Image Container */}
                    {showImages && (
                        <div class="w-full relative aspect-[16/9] overflow-hidden bg-[#050505] border-b border-white/10 p-2">
                            <div class="absolute inset-0 bg-brand-primary/20 mix-blend-overlay z-10 opacity-0 group-hover/card:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                            
                            {post.data.image ? (
                                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover grayscale-[30%] group-hover/card:grayscale-0 transition-all duration-700" />
                            ) : (
                                <div class="w-full h-full flex items-center justify-center bg-brand-dark">
                                    <span class="font-mono text-xs text-brand-primary/40 uppercase tracking-widest">AWAITING_PAYLOAD</span>
                                </div>
                            )}
                            
                            {/* UI Overlays */}
                            <div class="absolute top-4 left-4 w-4 h-4 border-t-2 border-l-2 border-white/30 z-20 pointer-events-none group-hover/card:border-brand-primary transition-colors"></div>
                            <div class="absolute bottom-4 right-4 w-4 h-4 border-b-2 border-r-2 border-white/30 z-20 pointer-events-none group-hover/card:border-brand-primary transition-colors"></div>
                        </div>
                    )}
                    
                    {/* Data Container */}
                    <div class="p-8 lg:p-10 flex flex-col flex-grow relative bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:1rem_1rem]">
                        <p class="font-mono text-brand-primary/60 text-xs tracking-widest uppercase mb-4 border-b border-white/5 pb-3 block w-full group-hover/card:text-brand-primary transition-colors flex items-center justify-between">
                            <span>{post.data.date.toString().substring(0, 15)}</span>
                            {post.data.category && (
                                <span class="bg-white/5 px-2 py-1 rounded-sm text-brand-light/40 border border-white/10 group-hover/card:border-brand-primary/40 group-hover/card:text-brand-primary">{post.data.category.replace("-", " ")}</span>
                            )}
                        </p>
                        <h3 class="text-2xl font-black text-white uppercase tracking-tight mb-4 group-hover/card:text-brand-primary transition-colors leading-tight">
                            {post.data.title}
                        </h3>
                        <p class="text-brand-light/60 text-sm leading-relaxed line-clamp-3 mb-8">
                            {post.data.description}
                        </p>
                        
                        <div class="mt-auto inline-flex items-center gap-3 font-mono text-brand-primary text-xs tracking-widest uppercase group-hover/card:text-white transition-colors border-b border-brand-primary/30 pb-1 w-max">
                            [ READ ARTICLE ]
                            <svg class="w-4 h-4 translate-x-0 group-hover/card:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                            </svg>
                        </div>
                    </div>

                </a>
            ))}
        </div>

        {/* Global Pagination Console */}
        {page && page.lastPage > 1 && (
            <div class="mt-16 w-full flex items-center justify-between border-t border-white/10 pt-8 font-mono text-sm tracking-widest uppercase text-brand-light/60">
                {page.url.prev ? (
                    <a href={page.url.prev} class="hover:text-brand-primary transition-transform duration-300 hover:-translate-x-2 flex items-center gap-2">
                        <span class="text-brand-primary">&larr;</span> Previous
                    </a>
                ) : (
                    <span class="opacity-20 cursor-not-allowed hidden md:inline-flex items-center gap-2">
                        <span>&larr;</span> Previous
                    </span>
                )}
                
                <span class="text-brand-primary/80 font-bold bg-brand-primary/5 px-6 py-2 border border-brand-primary/20 shadow-[0_0_10px_rgba(56,182,255,0.05)]">
                    Page {page.currentPage} of {page.lastPage}
                </span>

                {page.url.next ? (
                    <a href={page.url.next} class="hover:text-brand-primary transition-transform duration-300 hover:translate-x-2 flex items-center gap-2">
                        Next <span class="text-brand-primary">&rarr;</span>
                    </a>
                ) : (
                    <span class="opacity-20 cursor-not-allowed hidden md:inline-flex items-center gap-2">
                        Next <span>&rarr;</span>
                    </span>
                )}
            </div>
        )}
        
    </div>
</section>
