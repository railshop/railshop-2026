        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
            
            <div class="lg:col-span-5 relative group">
                <div class="absolute -inset-1 bg-brand-primary opacity-20 group-hover:opacity-40 blur transition duration-500"></div>
                <div class="relative bg-[#020202] border border-brand-primary/50 p-8 h-full flex flex-col justify-center shadow-[0_10px_30px_rgba(0,0,0,0.8)]">
                    <p class="font-mono text-brand-primary tracking-[0.2em] text-xs mb-6 uppercase">/// ABOUT RAILSHOP</p>
                    <h2 class="text-3xl md:text-5xl font-black tracking-tight uppercase text-white leading-[1.05] mb-8">
