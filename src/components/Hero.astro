---
---

<section class="relative min-h-[calc(100svh-4rem)] md:min-h-[calc(100svh-5rem)] flex items-center justify-center overflow-hidden bg-brand-dark border-b border-white/10">
  
  {/* Muted Heavy Equipment Background */}
  <div class="absolute inset-x-0 top-0 h-full z-0 pointer-events-none overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/60 via-brand-dark/20 to-brand-dark/90 z-20"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-transparent to-brand-dark z-10"></div>
      <img src="/images/hero/home_hero.webp" alt="Heavy Equipment Dispatch" class="w-full h-full object-cover object-[center_60%] opacity-[0.35] grayscale mix-blend-luminosity duration-1000 animate-fade-in" />
  </div>

  {/* Structural Grid Background */}
  <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
    <div class="absolute inset-0 animate-radar bg-[linear-gradient(rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_80%_80%_at_50%_50%,#000_10%,transparent_100%)]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-20 w-full text-center flex flex-col items-center">
    
    <div class="inline-flex items-center gap-3 animate-fade-in-up [animation-delay:200ms] opacity-0 mb-8 px-4 py-1.5 border border-brand-primary/40 bg-brand-primary/5 text-brand-primary text-xs font-mono uppercase tracking-[0.2em] shadow-[0_0_10px_rgba(56,182,255,0.1)]">
       <span class="w-1.5 h-1.5 rounded-none bg-brand-primary animate-pulse"></span> STATUS: ONLINE & ACCEPTING CLIENTS
    </div>
    
    <h1 class="text-4xl md:text-6xl lg:text-8xl font-black tracking-tight mb-8 animate-fade-in-up [animation-delay:400ms] opacity-0 text-balance leading-[1.05] uppercase">
      DIGITAL ENGINES <br class="hidden sm:block" />
      THAT BOOK <span class="text-brand-primary px-4 border border-brand-primary/30 relative inline-block ml-2 bg-brand-primary/10 select-none">JOBS.
        {/* Crosshairs */}
        <div class="absolute -top-1 -left-1 w-2 h-2 border-t border-l border-brand-primary"></div>
        <div class="absolute -top-1 -right-1 w-2 h-2 border-t border-r border-brand-primary"></div>
        <div class="absolute -bottom-1 -left-1 w-2 h-2 border-b border-l border-brand-primary"></div>
        <div class="absolute -bottom-1 -right-1 w-2 h-2 border-b border-r border-brand-primary"></div>
      </span>
    </h1>
    
    <p class="text-lg md:text-2xl text-brand-light/60 max-w-2xl mx-auto mb-12 animate-fade-in-up [animation-delay:600ms] opacity-0 text-balance font-light">
      We help service businesses scale lead flow and maximize ROI through high-performance websites and targeted paid ads.
    </p>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-6 animate-fade-in-up [animation-delay:800ms] opacity-0 w-full sm:w-auto font-mono text-sm tracking-widest">
      <a href="/contact" class="px-8 py-4 bg-brand-primary hover:bg-white text-brand-dark font-bold uppercase transition-all shadow-[inset_0_0_0_2px_#38b6ff] hover:shadow-[0_0_20px_rgba(255,255,255,0.5)] w-full sm:w-auto text-center relative group">
        [ BOOK A CALL ]
      </a>
      <a href="/work" class="px-8 py-4 bg-transparent border border-white/20 hover:border-white hover:bg-white/5 text-white font-medium uppercase transition-all w-full sm:w-auto text-center flex items-center justify-center gap-2">
        VIEW OUR WORK
      </a>
    </div>
  </div>
</section>

