---
import { getCollection } from 'astro:content';

const { filterTag, limit = true, customHeadline, customSubhead } = Astro.props;

const rawProjects = await getCollection('portfolio');

let displayProjects = rawProjects;
let headline = customHeadline || "Our Latest Work.";
let subhead = customSubhead || "A look at active engagements where great solutions meet real, measurable business growth.";

if (filterTag) {
    displayProjects = rawProjects.filter(p => p.data.services?.includes(filterTag)).slice(0, 2);
    headline = customHeadline || "Relevant Deployments.";
    subhead = customSubhead || "Proof of concept utilizing this precise architectural framework.";
} else if (limit) {
    displayProjects = displayProjects.slice(0, 4);
}
---

<section id="work" class="py-24 bg-brand-dark overflow-hidden relative border-t border-brand-mid">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
        <div class="mb-12 md:mb-20 flex flex-col md:flex-row md:items-end justify-between gap-6 md:gap-8 w-full">
            <div class="w-full md:w-auto">
                <p class="font-mono text-brand-primary tracking-[0.2em] text-sm mb-4 uppercase">/// RECENT WORK</p>
                <h2 class="text-3xl md:text-5xl font-black tracking-tight mb-4 uppercase">{headline}</h2>
                <p class="hidden md:block text-brand-light/60 text-base md:text-lg max-w-xl">
                    {subhead}
                </p>
            </div>
            {limit !== false && (
                <a href="/work" class="hidden md:flex font-mono text-brand-light hover:text-brand-primary text-sm tracking-widest uppercase items-center justify-center gap-2 transition-colors border border-white/20 px-6 py-4 hover:bg-brand-primary/10 hover:border-brand-primary w-full md:w-auto mt-2 md:mt-0">
                    [ VIEW ALL CASE STUDIES ]
                </a>
            )}
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12">
            {displayProjects.map((project) => (
                <a href={`/work/${project.id.replace('.md','')}`} class="group relative bg-brand-dark hover:bg-brand-mid/50 border border-white/10 transition-all duration-500 overflow-hidden block hover:border-brand-primary/50">
                    <div class="aspect-[16/10] overflow-hidden relative border-b border-white/10">
                        <div class="absolute inset-0 bg-transparent md:bg-brand-dark/40 mix-blend-multiply group-hover:bg-transparent transition-all duration-500 z-10"></div>
                        <img 
                            src={project.data.image} 
                            alt={project.data.title} 
                            class="w-full h-full object-cover transform group-hover:scale-[1.03] transition-transform duration-[1s]" 
                        />
                    </div>
                    
                    <div class="p-8 flex justify-between items-start bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:1rem_1rem]">
                        <div>
                            <p class="font-mono text-brand-primary/60 tracking-widest text-xs mb-2 uppercase group-hover:text-brand-primary transition-colors">{project.data.clientType}</p>
                            <h3 class="text-2xl font-bold text-white uppercase mb-4">{project.data.title}</h3>
                            <div class="inline-flex items-center gap-3 font-mono text-brand-primary text-xs tracking-widest uppercase group-hover:text-white transition-colors border-b border-brand-primary/30 pb-1 w-max">
                                [ READ CASE STUDY ]
                                <svg class="w-4 h-4 translate-x-0 group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                </svg>
                            </div>
                        </div>
                        <div class="font-mono text-xs text-brand-primary px-3 py-1 border border-brand-primary/20 bg-brand-primary/5 mt-1 hidden sm:block">ACTIVE</div>
                    </div>
                </a>
            ))}
        </div>

        {limit !== false && (
            <div class="mt-8 flex md:hidden w-full">
                <a href="/work" class="font-mono text-brand-light hover:text-brand-primary text-sm tracking-widest uppercase flex items-center justify-center gap-2 transition-colors border border-white/20 px-6 py-4 bg-brand-dark hover:bg-brand-primary/10 hover:border-brand-primary w-full text-center">
                    [ VIEW ALL CASE STUDIES ]
                </a>
            </div>
        )}
    </div>
</section>
