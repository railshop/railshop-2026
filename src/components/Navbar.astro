---
const links = [
  { 
    name: 'Services', 
    href: '/services',
    sublinks: [
        { name: 'Web Design', href: '/services/web-design' },
        { name: 'Paid Ads', href: '/services/paid-ads' },
        { name: 'SEO', href: '/services/seo' },
        { name: 'Content Creation', href: '/services/content-creation' },
        { name: 'Digital Strategy', href: '/services/digital-strategy-consulting' },
        { name: 'AI Integration', href: '/services/ai-integration' }
    ]
  },
  { name: 'Work', href: '/work' },
  { name: 'About', href: '/about' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' }
];
---

<header class="fixed top-0 inset-x-0 z-50 py-4 transition-all duration-300 pointer-events-none">
  <div class="max-w-7xl mx-auto px-4 lg:px-8 relative">
    <nav class="pointer-events-auto flex items-center justify-between bg-brand-dark/95 backdrop-blur-md border border-white/10 py-3 px-5 sm:px-6 shadow-[0_10px_30px_rgba(0,0,0,0.8)] relative z-50">
      <a href="/" class="text-xl font-black tracking-widest text-white flex items-center group uppercase relative">
        RAILSHOP<span class="text-brand-primary relative top-[1px] -ml-[2px]">.</span>
      </a>
      
      <ul class="hidden md:flex items-center gap-8">
        {links.map(link => (
          <li class={link.sublinks ? "relative group" : ""}>
            <a href={link.href} class="font-mono text-xs tracking-widest text-brand-light/50 hover:text-brand-primary transition-colors uppercase flex items-center gap-1.5 before:content-['>'] before:text-brand-primary before:opacity-0 hover:before:opacity-100 before:transition-opacity py-4">
              {link.name}
              {link.sublinks && (
                <svg class="w-3 h-3 text-brand-primary/50 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            
            {link.sublinks && (
              <div class="absolute top-[80%] left-0 pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 w-64 z-[100]">
                <div class="bg-[#020202] border border-brand-primary/30 shadow-[0_20px_50px_rgba(0,0,0,0.8)] relative">
                  <div class="w-full h-1 bg-brand-primary top-0 left-0 absolute z-20"></div>
                  <ul class="flex flex-col relative z-20 bg-[#020202]">
                    {link.sublinks.map(sublink => (
                      <li>
                        <a href={sublink.href} class="block px-5 py-4 font-mono text-xs tracking-widest text-brand-light/60 hover:text-brand-primary transition-all duration-300 uppercase border-b border-white/5 last:border-0 hover:bg-brand-primary/10 hover:pl-8">
                          {sublink.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
            
          </li>
        ))}
      </ul>
      
      <a href="/contact" class="hidden md:inline-flex px-6 py-2 border border-brand-primary/50 hover:bg-brand-primary/10 text-brand-primary font-mono text-xs tracking-widest uppercase transition-colors">
        [ BOOK A CALL ]
      </a>
      
      {/* Mobile Menu Toggle Engine */}
      <button id="mobile-menu-btn" class="md:hidden flex items-center justify-center text-white p-2 hover:text-brand-primary transition-colors cursor-pointer relative w-10 h-10" aria-label="Toggle Navigation">
        <svg id="menu-icon-open" class="w-7 h-7 absolute transition-all duration-300 transform scale-100 rotate-0 opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="menu-icon-close" class="w-7 h-7 absolute transition-all duration-300 transform scale-50 -rotate-90 opacity-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </nav>

    {/* Mobile Action Dropdown Component (Hidden by Default) */}
    <div id="mobile-menu-pane" class="md:hidden absolute top-[95%] left-4 right-4 bg-[#020202] border border-white/10 border-t-0 shadow-[0_20px_50px_rgba(0,0,0,0.9)] opacity-0 invisible translate-y-[-10px] transition-all duration-300 z-40 pointer-events-auto flex flex-col pt-4 pb-6">
        <div class="w-full h-1 bg-brand-primary top-0 left-0 absolute z-20"></div>
        <ul class="flex flex-col w-full text-left relative z-20">
            {links.map((link, index) => (
                <li class="w-full">
                    {link.sublinks ? (
                        <button class="w-full flex items-center justify-between px-8 py-5 font-mono text-sm tracking-widest text-white hover:text-brand-primary transition-colors uppercase border-b border-white/5 last:border-0 mobile-accordion-btn text-left" data-target={`mobile-accordion-${index}`}>
                            <span><span class="text-brand-primary opacity-50 mr-2">></span> {link.name}</span>
                            <span class="text-brand-primary opacity-80 text-[10px] accordion-icon">[ + ]</span>
                        </button>
                    ) : (
                        <a href={link.href} class="block px-8 py-5 font-mono text-sm tracking-widest text-white hover:text-brand-primary transition-colors uppercase border-b border-white/5 last:border-0">
                            <span class="text-brand-primary opacity-50 mr-2">></span> {link.name}
                        </a>
                    )}
                    
                    {/* Render Sublinks inside mobile accordian hidden by default */}
                    {link.sublinks && (
                        <div id={`mobile-accordion-${index}`} class="hidden flex-col w-full bg-white/[0.02]">
                            <ul class="flex flex-col w-full">
                                <li>
                                    <a href={link.href} class="block px-8 py-4 pl-14 font-mono text-xs tracking-widest text-brand-primary hover:text-white transition-colors uppercase border-b border-white/5 last:border-0 font-bold">
                                        - View All {link.name}
                                    </a>
                                </li>
                                {link.sublinks.map(sublink => (
                                    <li>
                                        <a href={sublink.href} class="block px-8 py-4 pl-14 font-mono text-xs tracking-widest text-brand-light/60 hover:text-brand-primary transition-colors uppercase border-b border-white/5 last:border-0">
                                            - {sublink.name}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )}
                </li>
            ))}
        </ul>
        <div class="px-8 mt-6 w-full object-bottom">
            <a href="/contact" class="flex justify-center w-full px-6 py-4 bg-brand-primary text-brand-dark font-bold font-mono text-xs tracking-widest uppercase hover:bg-white transition-colors cursor-pointer">
                [ BOOK A CALL ]
            </a>
        </div>
    </div>
  </div>
</header>

<script>
    // Native Vanilla JS execution to hijack standard DOM rendering
    document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const pane = document.getElementById('mobile-menu-pane');
        const iconOpen = document.getElementById('menu-icon-open');
        const iconClose = document.getElementById('menu-icon-close');
        
        let isOpen = false;

        if (btn && pane && iconOpen && iconClose) {
            btn.addEventListener('click', () => {
                isOpen = !isOpen;
                
                if (isOpen) {
                    pane.classList.remove('opacity-0', 'invisible', 'translate-y-[-10px]');
                    pane.classList.add('opacity-100', 'visible', 'translate-y-0');
                    iconOpen.classList.remove('scale-100', 'rotate-0', 'opacity-100');
                    iconOpen.classList.add('scale-50', 'rotate-90', 'opacity-0');
                    
                    iconClose.classList.remove('scale-50', '-rotate-90', 'opacity-0');
                    iconClose.classList.add('scale-100', 'rotate-0', 'opacity-100');
                } else {
                    pane.classList.remove('opacity-100', 'visible', 'translate-y-0');
                    pane.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
                    
                    iconOpen.classList.remove('scale-50', 'rotate-90', 'opacity-0');
                    iconOpen.classList.add('scale-100', 'rotate-0', 'opacity-100');
                    
                    iconClose.classList.remove('scale-100', 'rotate-0', 'opacity-100');
                    iconClose.classList.add('scale-50', '-rotate-90', 'opacity-0');
                }
            });
        }

        // Accordion Engine for Mobile Nav
        const accordionBtns = document.querySelectorAll('.mobile-accordion-btn');
        accordionBtns.forEach(accBtn => {
            accBtn.addEventListener('click', (e) => {
                e.preventDefault();
                const targetId = accBtn.getAttribute('data-target');
                const targetEl = document.getElementById(targetId);
                const icon = accBtn.querySelector('.accordion-icon');
                
                if (targetEl && icon) {
                    if (targetEl.classList.contains('hidden')) {
                        targetEl.classList.remove('hidden');
                        targetEl.classList.add('flex');
                        icon.textContent = '[ - ]';
                    } else {
                        targetEl.classList.add('hidden');
                        targetEl.classList.remove('flex');
                        icon.textContent = '[ + ]';
                    }
                }
            });
        });
    });
</script>
