---
export interface Props {
    serviceId: string;
}

const { serviceId } = Astro.props;
---

<div class="w-full h-full flex items-center justify-center p-12 text-brand-primary opacity-30 group-hover:opacity-100 transition-all duration-700 drop-shadow-[0_0_20px_rgba(56,182,255,0.4)] group-hover:drop-shadow-[0_0_40px_rgba(56,182,255,0.8)] mix-blend-lighten">
    {serviceId === 'web-design' && (
        <svg class="w-full h-full max-w-[70%] max-h-[70%] animate-pulse-slow" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            {/* Outline Browser */}
            <rect x="20" y="30" width="160" height="120" rx="4" stroke="currentColor" stroke-width="3" />
            <line x1="20" y1="50" x2="180" y2="50" stroke="currentColor" stroke-width="3" />
            <circle cx="35" cy="40" r="3" fill="currentColor" />
            <circle cx="45" cy="40" r="3" fill="currentColor" />
            
            {/* Outline Mobile Overlay */}
            <rect x="130" y="80" width="40" height="70" rx="4" fill="#020202" stroke="currentColor" stroke-width="3" />
            <line x1="145" y1="88" x2="155" y2="88" stroke="currentColor" stroke-width="2" />
            
            {/* Geometric Grid Lines */}
            <path d="M40 70 L140 70 M40 90 L110 90 M40 110 L90 110" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="4 4" opacity="0.6"/>
        </svg>
    )}

    {serviceId === 'paid-ads' && (
        <svg class="w-full h-full max-w-[70%] max-h-[70%] animate-pulse-slow" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            {/* Target Reticle */}
            <circle cx="100" cy="100" r="80" stroke="currentColor" stroke-width="2" stroke-dasharray="10 10" opacity="0.4" />
            <circle cx="100" cy="100" r="50" stroke="currentColor" stroke-width="3" />
            <line x1="100" y1="10" x2="100" y2="40" stroke="currentColor" stroke-width="3" />
            <line x1="100" y1="160" x2="100" y2="190" stroke="currentColor" stroke-width="3" />
            <line x1="10" y1="100" x2="40" y2="100" stroke="currentColor" stroke-width="3" />
            <line x1="160" y1="100" x2="190" y2="100" stroke="currentColor" stroke-width="3" />

            {/* Growth Graph */}
            <polyline points="40,160 80,120 120,140 170,60" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
            <polygon points="175,55 155,60 170,75" fill="currentColor" />
        </svg>
    )}

    {serviceId === 'seo' && (
        <svg class="w-full h-full max-w-[70%] max-h-[70%] animate-pulse-slow" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            {/* Local Radar Waves */}
            <ellipse cx="100" cy="150" rx="80" ry="25" stroke="currentColor" stroke-width="2" opacity="0.2" />
            <ellipse cx="100" cy="150" rx="55" ry="15" stroke="currentColor" stroke-width="2" opacity="0.4" />
            <ellipse cx="100" cy="150" rx="30" ry="8" stroke="currentColor" stroke-width="3" />

            {/* Map Pin */}
            <path d="M100 20 C65 20, 50 55, 50 85 C50 125, 100 150, 100 150 C100 150, 150 125, 150 85 C150 55, 135 20, 100 20 Z" stroke="currentColor" stroke-width="4" stroke-linejoin="round" fill="#020202" />
            <circle cx="100" cy="70" r="20" stroke="currentColor" stroke-width="3" fill="none" />
        </svg>
    )}

    {serviceId === 'content-creation' && (
        <svg class="w-full h-full max-w-[70%] max-h-[70%] animate-pulse-slow" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            {/* Camera Frame */}
            <rect x="25" y="40" width="150" height="120" rx="10" stroke="currentColor" stroke-width="4" fill="none" />
            
            {/* Abstract Aperture */}
            <circle cx="100" cy="100" r="45" stroke="currentColor" stroke-width="3" fill="none" />
            <line x1="100" y1="55" x2="120" y2="75" stroke="currentColor" stroke-width="2" />
            <line x1="145" y1="100" x2="125" y2="120" stroke="currentColor" stroke-width="2" />
            <line x1="100" y1="145" x2="80" y2="125" stroke="currentColor" stroke-width="2" />
            <line x1="55" y1="100" x2="75" y2="80" stroke="currentColor" stroke-width="2" />

            {/* Play Button Node */}
            <polygon points="90,85 90,115 115,100" fill="currentColor" />
            
            {/* Recording Light */}
            <circle cx="155" cy="65" r="4" fill="currentColor" />
        </svg>
    )}

    {serviceId === 'digital-strategy-consulting' && (
        <svg class="w-full h-full max-w-[70%] max-h-[70%] animate-pulse-slow" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            {/* Central Node */}
            <polygon points="100,50 145,75 145,125 100,150 55,125 55,75" stroke="currentColor" stroke-width="4" fill="#020202" stroke-linejoin="round" />
            <circle cx="100" cy="100" r="15" fill="currentColor" />
            
            {/* Connecting Nodes */}
            <circle cx="30" cy="40" r="8" stroke="currentColor" stroke-width="3" fill="none"/>
            <circle cx="170" cy="40" r="8" stroke="currentColor" stroke-width="3" fill="none"/>
            <circle cx="100" cy="190" r="8" stroke="currentColor" stroke-width="3" fill="none"/>

            {/* Path Connections */}
            <path d="M40 45 L70 65 L85 90" stroke="currentColor" stroke-width="2" opacity="0.6" stroke-dasharray="4 4" />
            <path d="M160 45 L130 65 L115 90" stroke="currentColor" stroke-width="2" opacity="0.6" stroke-dasharray="4 4" />
            <path d="M100 180 L100 135" stroke="currentColor" stroke-width="2" opacity="0.6" stroke-dasharray="4 4" />
        </svg>
    )}

    {serviceId === 'ai-integration' && (
        <svg class="w-full h-full max-w-[70%] max-h-[70%] animate-pulse-slow" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            {/* Server Chassis Base */}
            <rect x="40" y="140" width="120" height="40" rx="4" stroke="currentColor" stroke-width="3" fill="none" />
            <line x1="55" y1="150" x2="145" y2="150" stroke="currentColor" stroke-width="2" />
            <circle cx="135" cy="165" r="3" fill="currentColor" />
            <circle cx="120" cy="165" r="3" fill="currentColor" />

            {/* Neural Net Brain */}
            <circle cx="100" cy="60" r="35" stroke="currentColor" stroke-width="3" stroke-dasharray="6 6" />
            <path d="M80 50 Q100 10 120 50 Q140 80 100 80 Q60 80 80 50 Z" stroke="currentColor" stroke-width="1" fill="none" opacity="0.5" />
            <circle cx="100" cy="60" r="10" fill="currentColor" />

            {/* Neural Connections */}
            <path d="M100 95 L100 140" stroke="currentColor" stroke-width="3" />
            <path d="M80 85 L60 140" stroke="currentColor" stroke-width="2" opacity="0.7" />
            <path d="M120 85 L140 140" stroke="currentColor" stroke-width="2" opacity="0.7" />
        </svg>
    )}
</div>
